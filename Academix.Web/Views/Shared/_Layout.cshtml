<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Academix</title>

    <script type="importmap"></script>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Academix.Web.styles.css" asp-append-version="true" />
</head>
<body>
    <header class="site-header">
        <nav class="navbar navbar-expand-lg">
            <div class="container academix-container">
                <a class="navbar-brand academix-brand"
                   asp-area="" asp-controller="Home" asp-action="Index">
                    <span class="brand-mark">A</span>
                    <span>Academix</span>
                </a>

                <button class="navbar-toggler" type="button"
                        data-bs-toggle="collapse"
                        data-bs-target="#mainNavbar"
                        aria-controls="mainNavbar"
                        aria-expanded="false"
                        aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="mainNavbar">
                    <ul class="navbar-nav mx-auto academix-nav">
                        <li class="nav-item">
                            <a class="nav-link"
                               asp-area="" asp-controller="Home" asp-action="Index">
                                Home
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link"
                               asp-area="" asp-controller="Subject" asp-action="Index">
                                All Subjects
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link"
                               asp-area="" asp-controller="Subject" asp-action="MySubjects">
                                My Subjects
                            </a>
                        </li>
                    </ul>

                    <div class="academix-account">
                        <partial name="_LoginPartial" />
                    </div>
                </div>
            </div>
        </nav>
    </header>

    <div class="container academix-container page-container">
        <main role="main" class="page-content">
            @RenderBody()
        </main>
    </div>

    <footer class="site-footer">
        <div class="container academix-container footer-content">
            <span>© 2026 Academix</span>
            <span class="footer-tagline">A quieter way to achieve more.</span>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>