@model SubjectViewModel

@{
    ViewData["Title"] = "Subject Details";
}

<section class="subject-details-page">
    <a asp-controller="Subject"
       asp-action="MySubjects"
       class="subject-details-back">
        <span aria-hidden="true">←</span> Back to My Subjects
    </a>

    <article class="subject-details-content">
        <div class="subject-details-label">
            <span></span>
            SUBJECT OVERVIEW
        </div>

        <h1>@Model.Name</h1>

        <div class="subject-details-divider"></div>

        <section class="subject-description">
            <h2>About this subject</h2>

            @if (string.IsNullOrWhiteSpace(Model.Description))
            {
                <p class="subject-description-empty">
                    No description has been added for this subject yet.
                </p>
            }
            else
            {
                <p class="subject-description-text">@Model.Description</p>
            }
        </section>

        <footer class="subject-details-footer">
            <a asp-controller="Subject"
               asp-action="MySubjects"
               class="subject-details-secondary">
                My Subjects
            </a>

            <a asp-controller="Subject"
               asp-action="Index"
               class="subject-details-primary">
                Explore All Subjects
                <span aria-hidden="true">→</span>
            </a>
        </footer>
    </article>
</section>
