@model IEnumerable<SubjectViewModel>

@{
    ViewData["Title"] = "My Subjects";
}

<div class="container py-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="fw-bold">My Subjects</h1>
            <p class="text-muted">Your selected subjects.</p>
        </div>

        <a asp-controller="Subject"
           asp-action="Index"
           class="btn btn-primary">
            Explore Subjects
        </a>
    </div>

    @if (!Model.Any())
    {
        <div class="text-center py-5">
            <h3>No subjects yet</h3>
            <p class="text-muted">
                Add subjects from the catalog to see them here.
            </p>

            <a asp-controller="Subject"
               asp-action="Index"
               class="btn btn-primary">
                Browse Subjects
            </a>
        </div>
    }
    else
    {
        <div class="list-group">
            @foreach (var subject in Model)
            {
                <div class="list-group-item d-flex justify-content-between align-items-center p-3">
                    <h5 class="mb-0">@subject.Name</h5>

                    <a asp-controller="Subject"
                       asp-action="Details"
                       asp-route-id="@subject.Id"
                       class="btn btn-outline-primary">
                        View Details
                    </a>
                    <a asp-controller="StudyTask"
                       asp-action="Create"
                       asp-route-subjectId="@subject.Id"
                       class="btn btn-primary">
                        Create Task
                    </a>
                    <a asp-controller="StudyTask"
                       asp-action="TasksOfSubject"
                       asp-route-subjectId="@subject.Id"
                       class="btn btn-outline-primary">
                        View Tasks
                    </a>
                    <a asp-controller="Exam"
                       asp-action="ExamsOfSubject"
                       asp-route-subjectId="@subject.Id"
                       class="btn btn-outline-primary btn-sm">
                        Exams
                    </a>
                </div>
            }
        </div>
    }
</div>