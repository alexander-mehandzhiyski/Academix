@model IEnumerable<Academix.Web.ViewModels.Subject.SubjectViewModel>

@{
    ViewData["Title"] = "All Subjects";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1>All Subjects</h1>

        @if (User.Identity?.IsAuthenticated == true)
        {
            <a asp-action="MySubjects"
               class="btn btn-outline-primary">
                My Subjects
            </a>
        }
    </div>

    <div class="row">
        @foreach (var subject in Model)
        {
            <div class="col-md-4 mb-3">
                <div class="card h-100">
                    <div class="card-body">
                        <h5 class="card-title">@subject.Name</h5>

                        <p class="card-text">
                            @subject.Description
                        </p>

                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            if (subject.IsAdded)
                            {
                                <button class="btn btn-secondary"
                                        disabled>
                                    Added
                                </button>
                            }
                            else
                            {
                                <form asp-action="Add"
                                      asp-route-id="@subject.Id"
                                      method="post">
                                    @Html.AntiForgeryToken()

                                    <button type="submit"
                                            class="btn btn-primary">
                                        Add to My Subjects
                                    </button>
                                </form>
                            }
                        }
                        else
                        {
                            <a asp-area="Identity"
                               asp-page="/Account/Login"
                               class="btn btn-outline-primary">
                                Log in to add
                            </a>
                        }
                    </div>
                </div>
            </div>
        }
    </div>
</div>
