@model IEnumerable<SubjectViewModel>

@{
    ViewData["Title"] = "All Subjects";
}

<div class="container py-5">
    <h1 class="fw-bold mb-2">All Subjects</h1>
    <p class="text-muted mb-4">
        Explore the available subjects.
    </p>

    @if (!Model.Any())
    {
        <p>No subjects are available yet.</p>
    }
    else
    {
        <div class="list-group">
            @foreach (var subject in Model)
            {
                <div class="list-group-item d-flex justify-content-between align-items-center p-3">
                    <h5 class="mb-0">@subject.Name</h5>

                    @if (subject.IsAdded)
                    {
                        <span class="badge bg-success">Added</span>
                    }
                    else if (User.Identity?.IsAuthenticated == true)
                    {
                        <form asp-controller="Subject"
                              asp-action="AddToMySubjects"
                              method="post">
                            <input type="hidden"
                                   name="subjectId"
                                   value="@subject.Id" />

                            <button type="submit"
                                    class="btn btn-primary">
                                Add to My Subjects
                            </button>
                        </form>
                    }
                    else
                    {
                        <a asp-area="Identity"
                           asp-page="/Account/Login"
                           class="btn btn-outline-primary">
                            Log in to add
                        </a>
                    }
                </div>
            }
        </div>
    }
</div>