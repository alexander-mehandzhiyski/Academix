@model ExamInputModel

@{
    ViewData["Title"] = "Edit Exam";
}

<div class="task-form-page">
    <a asp-controller="Exam"
       asp-action="ExamsOfSubject"
       asp-route-subjectId="@Model.SubjectId"
       class="task-form-back">
        ← Back to exams
    </a>

    <div class="task-form-header">
        <span class="task-form-eyebrow">YOUR LEARNING</span>
        <h1>Edit exam</h1>
        <p>Update your exam schedule or adjust your goal grade.</p>
    </div>

    <div class="task-form-card">
        <div class="task-form-card-heading">
            <span class="task-form-icon task-form-icon-edit">✎</span>
            <div>
                <h2>Exam details</h2>
                <p>Make your changes below.</p>
            </div>
        </div>

        <form asp-controller="Exam"
              asp-action="Edit"
              asp-route-examId="@ViewBag.ExamId"
              method="post">

            @Html.AntiForgeryToken()

            <div asp-validation-summary="ModelOnly"
                 class="task-form-validation"></div>

            <input type="hidden" asp-for="SubjectId" />

            <div class="task-form-field">
                <label asp-for="Title">Exam title</label>
                <input asp-for="Title"
                       class="task-form-input"
                       placeholder="Enter exam title" />
                <span asp-validation-for="Title"
                      class="task-form-error"></span>
            </div>

            <div class="task-form-field">
                <label asp-for="ExamDate">Exam date and time</label>
                <input asp-for="ExamDate"
                       type="datetime-local"
                       asp-format="{0:yyyy-MM-ddTHH:mm}"
                       class="task-form-input" />
                <span asp-validation-for="ExamDate"
                      class="task-form-error"></span>
            </div>

            <div class="task-form-field">
                <label asp-for="Grade">Goal grade <span>(optional)</span></label>

                <input asp-for="Grade"
                       type="number"
                       min="2"
                       max="6"
                       step="0.01"
                       class="task-form-input"
                       placeholder="e.g. 5.50" />

                <span asp-validation-for="Grade"
                      class="task-form-error"></span>

                <p class="exam-field-hint">
                    Set the grade you would like to achieve on this exam.
                </p>
            </div>

            <div class="task-form-actions">
                <a asp-controller="Exam"
                   asp-action="ExamsOfSubject"
                   asp-route-subjectId="@Model.SubjectId"
                   class="task-form-cancel">
                    Cancel
                </a>

                <button type="submit" class="task-form-submit">
                    Save changes <span>→</span>
                </button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
