@model IEnumerable<StudyTaskViewModel>

@{
    ViewData["Title"] = "Study Tasks";
}

<div class="container py-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="fw-bold">Study Tasks</h1>
            <p class="text-muted">
                Tasks for @Model.FirstOrDefault()?.SubjectName
            </p>
        </div>
    </div>

    @if (!Model.Any())
    {
        <div class="text-center py-5">
            <h3>No tasks yet</h3>
            <p class="text-muted">
                Create your first task for this subject.
            </p>
        </div>
    }
    else
    {
        <div class="list-group">
            @foreach (var task in Model)
            {
                <div class="list-group-item d-flex justify-content-between align-items-center p-3">
                    <div>
                        <h5 class="mb-1">@task.Title</h5>
                        <small class="text-muted">
                            Due: @task.DueDate.ToString("dd.MM.yyyy HH:mm")
                        </small>
                    </div>
                    <a asp-controller="StudyTask"
                       asp-action="Edit"
                       asp-route-taskId="@task.Id"
                       class="btn btn-outline-primary btn-sm">
                        Edit
                    </a>
                    <a asp-controller="StudyTask"
                       asp-action="Delete"
                       asp-route-taskId="@task.Id"
                       class="btn btn-outline-danger btn-sm">
                        Delete
                    </a>

                    @if (task.IsCompleted)
                    {
                        <span class="badge bg-success">Completed</span>
                    }
                    else
                    {
                        <span class="badge bg-warning text-dark">Pending</span>
                    }
                </div>
            }
        </div>
    }
</div>
