@model IEnumerable<StudyTaskViewModel>

@{
    ViewData["Title"] = "Study Tasks";
    var tasks = Model.ToList();
    var subjectName = tasks.FirstOrDefault()?.SubjectName;
    var completedCount = tasks.Count(t => t.IsCompleted);
}

<div class="study-tasks-page">

    
    <header class="study-tasks-header">
        <div>
            <span class="study-tasks-eyebrow">YOUR LEARNING</span>
            <h1>Study Tasks</h1>
            <p class="study-tasks-subtitle">
                @if (!string.IsNullOrWhiteSpace(subjectName))
                {
                    <span>Tasks for <strong>@subjectName</strong></span>
                }
                else
                {
                    <span>Organize your learning, one task at a time.</span>
                }
            </p>
        </div>

        <div class="study-tasks-header-actions">
            @if (tasks.Any())
            {
                <div class="study-tasks-summary">
                    <span class="study-tasks-summary-label">COMPLETED</span>
                    <span class="study-tasks-summary-value">
                        @completedCount <span>/ @tasks.Count</span>
                    </span>
                </div>
            }

            <a asp-controller="StudyTask"
               asp-action="Create"
               asp-route-subjectId="@tasks.FirstOrDefault()?.SubjectId"
               class="study-tasks-create">
                <span aria-hidden="true">+</span> Create Task
            </a>
        </div>
    </header>


    <div class="study-tasks-progress">
        <div class="study-tasks-progress-track">
            <div class="study-tasks-progress-fill"
                 style="width: @(tasks.Count == 0 ? 0 : completedCount * 100 / tasks.Count)%">
            </div>
        </div>
        <span>
            @(tasks.Count == 0 ? 0 : completedCount * 100 / tasks.Count)% complete
        </span>
    </div>

    @if (!tasks.Any())
    {
        <section class="study-tasks-empty">
            <div class="study-tasks-empty-mark">+</div>
            <h2>No tasks yet</h2>
            <p>
                Your study plan starts here. When tasks are added to this
                subject, they will appear on this page.
            </p>
        </section>
    }
    else
    {
        <section class="study-tasks-list">
            <div class="study-tasks-list-heading">
                <h2>Your tasks</h2>
                <span>@tasks.Count @(tasks.Count == 1 ? "task" : "tasks")</span>
            </div>

            @foreach (var task in tasks)
            {
                <article class="study-task-row @(task.IsCompleted ? "study-task-completed" : "")">
                    <div class="study-task-indicator">
                        @if (task.IsCompleted)
                        {
                            <span class="study-task-check">✓</span>
                        }
                        else
                        {
                            <span class="study-task-number"></span>
                        }
                    </div>

                    <div class="study-task-content">
                        <h3>@task.Title</h3>

                        <p class="study-task-due">
                            <span class="study-task-due-label">DUE DATE</span>
                            @task.DueDate.ToString("dd.MM.yyyy · HH:mm")
                        </p>
                    </div>

                    <div class="study-task-status">
                        @if (task.IsCompleted)
                        {
                            <span class="study-task-badge study-task-badge-done">
                                Completed
                            </span>
                        }
                        else
                        {
                            <span class="study-task-badge study-task-badge-pending">
                                Pending
                            </span>
                        }
                    </div>

                    <div class="study-task-actions">
                        <form asp-controller="StudyTask"
                              asp-action="SetCompleted"
                              asp-route-subjectId="@task.SubjectId"
                              method="post">
                            @Html.AntiForgeryToken()

                            <input type="hidden"
                                   name="taskId"
                                   value="@task.Id" />

                            <input type="hidden"
                                   name="isCompleted"
                                   value="@(!task.IsCompleted ? "true" : "false")" />

                            <button type="submit"
                                    class="study-task-action @(task.IsCompleted ? "study-task-action-pending" : "study-task-action-complete")">
                                @(task.IsCompleted ? "Mark pending" : "Complete")
                            </button>
                        </form>

                        <a asp-controller="StudyTask"
                           asp-action="Edit"
                           asp-route-taskId="@task.Id"
                           class="study-task-edit">
                            Edit
                        </a>

                        <a asp-controller="StudyTask"
                           asp-action="Delete"
                           asp-route-taskId="@task.Id"
                           class="study-task-delete">
                            Delete
                        </a>
                    </div>
                </article>
            }
        </section>
    }
</div>
