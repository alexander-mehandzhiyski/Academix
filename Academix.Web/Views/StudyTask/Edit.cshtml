@model StudyTaskInputModel

@{
    ViewData["Title"] = "Edit Study Task";
}

<div class="task-form-page">
    <a asp-controller="StudyTask"
       asp-action="TasksOfSubject"
       asp-route-subjectId="@Model.SubjectId"
       class="task-form-back">
        ← Back to tasks
    </a>

    <div class="task-form-header">
        <span class="task-form-eyebrow">YOUR LEARNING</span>
        <h1>Edit study task</h1>
        <p>Update your task details and keep your study plan on track.</p>
    </div>

    <div class="task-form-card">
        <div class="task-form-card-heading">
            <span class="task-form-icon task-form-icon-edit">✎</span>
            <div>
                <h2>Task details</h2>
                <p>Make the changes you need below.</p>
            </div>
        </div>

        <form asp-controller="StudyTask"
              asp-action="Edit"
              asp-route-taskId="@ViewBag.TaskId"
              method="post">

            <div asp-validation-summary="ModelOnly"
                 class="task-form-validation"></div>

            <input type="hidden" asp-for="SubjectId" />

            <div class="task-form-field">
                <label asp-for="Title">Task title</label>
                <input asp-for="Title"
                       class="task-form-input"
                       placeholder="Enter task title" />
                <span asp-validation-for="Title"
                      class="task-form-error"></span>
            </div>

            <div class="task-form-field">
                <label asp-for="Description">Description <span>(optional)</span></label>
                <textarea asp-for="Description"
                          class="task-form-input task-form-textarea"
                          rows="4"
                          placeholder="Describe your task"></textarea>
                <span asp-validation-for="Description"
                      class="task-form-error"></span>
            </div>

            <div class="task-form-field">
                <label asp-for="DueDate">Due date</label>
                <input asp-for="DueDate"
                       type="datetime-local"
                       class="task-form-input" />
                <span asp-validation-for="DueDate"
                      class="task-form-error"></span>
            </div>

            <div class="task-form-actions">
                <a asp-controller="StudyTask"
                   asp-action="TasksOfSubject"
                   asp-route-subjectId="@Model.SubjectId"
                   class="task-form-cancel">
                    Cancel
                </a>

                <button type="submit" class="task-form-submit">
                    Save changes <span>→</span>
                </button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
