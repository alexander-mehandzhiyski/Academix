@model StudyTaskViewModel

@{
    ViewData["Title"] = "Delete Study Task";
}

<div class="task-form-page task-delete-page">
    <a asp-controller="StudyTask"
       asp-action="TasksOfSubject"
       asp-route-subjectId="@Model.SubjectId"
       class="task-form-back">
        ← Back to tasks
    </a>

    <div class="task-delete-card">
        <div class="task-delete-icon">!</div>

        <span class="task-form-eyebrow">TASK MANAGEMENT</span>
        <h1>Delete this task?</h1>

        <p class="task-delete-intro">
            Are you sure you want to delete this study task?
            This action cannot be undone.
        </p>

        <div class="task-delete-details">
            <span class="task-delete-label">TASK TITLE</span>
            <h2>@Model.Title</h2>

            <div class="task-delete-meta">
                <div>
                    <span class="task-delete-label">SUBJECT</span>
                    <p>@Model.SubjectName</p>
                </div>

                <div>
                    <span class="task-delete-label">DUE DATE</span>
                    <p>@Model.DueDate.ToString("dd.MM.yyyy HH:mm")</p>
                </div>
            </div>
        </div>

        <form asp-controller="StudyTask"
              asp-action="DeleteConfirmed"
              asp-route-taskId="@Model.Id"
              asp-route-subjectId="@Model.SubjectId"
              method="post">

            @Html.AntiForgeryToken()

            <div class="task-delete-actions">
                <a asp-controller="StudyTask"
                   asp-action="TasksOfSubject"
                   asp-route-subjectId="@Model.SubjectId"
                   class="task-form-cancel">
                    Cancel
                </a>

                <button type="submit" class="task-delete-confirm">
                    Delete task
                </button>
            </div>
        </form>
    </div>
</div>
